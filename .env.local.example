# Copie este arquivo para .env.local (desenvolvimento) OU configure as mesmas
# variáveis no painel da Vercel (Settings > Environment Variables) para produção.
# Sem essas variáveis, o dashboard funciona normalmente com dados de exemplo.

# Token gerado no Graph API Explorer (https://developers.facebook.com/tools/explorer/)
# Permissões necessárias para business_discovery:
#   - instagram_business_basic
#   - pages_show_list
#   - business_management
# Para produção, use um token LONG-LIVED (Menu > Get Token > exchange) ou um
# System User (não expira). Tokens curtos expiram em ~1h.
INSTAGRAM_ACCESS_TOKEN=

# ID da sua conta comercial do Instagram (Instagram Business Account ID), associada
# à sua Página do Facebook. É a "sua" conta usada para buscar outros perfis via
# business_discovery. Encontrado no Graph API Explorer ao selecionar sua conta.
INSTAGRAM_BUSINESS_ID=

# Username padrão do perfil analisado no Dashboard (conta comercial/criadora
# pública no Instagram). O usuário ainda pode mudar via ?target= na URL.
INSTAGRAM_TARGET_USERNAME=biodev

# VERIFICAÇÃO DE DOMÍNIO DO APP META (opicional)
# Meta pede um <meta name="facebook-domain-verification" content="..."> na home
# para confirmar que você controla o domínio de onde o app roda. Preencha aqui
# o código que a Meta te der e o dashboard injeta a tag no <head> sozinho:
#   https://business.facebook.com/settings/domains  ->  Domains  ->  Add
# Deixe vazio se ainda não tiver o código.
META_VERIFICATION_CODE=
