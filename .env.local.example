# Copie este arquivo para .env.local e preencha para usar dados REAIS do Instagram.
# Sem essas variáveis, o dashboard funciona normalmente com dados de exemplo.

# Token gerado no Graph API Explorer (https://developers.facebook.com/tools/explorer/)
# com as permissões: instagram_basic, pages_show_list, pages_read_engagement, business_management
INSTAGRAM_ACCESS_TOKEN=

# ID da conta comercial do Instagram (Instagram Business Account ID) associada
# à sua Página do Facebook — é a "sua" conta usada para consultar outros perfis públicos.
INSTAGRAM_BUSINESS_ID=

# Username do perfil que você quer analisar no Dashboard (precisa ser conta
# comercial/criador de conteúdo pública no Instagram). Padrão: biodev
INSTAGRAM_TARGET_USERNAME=biodev
